            "type": "ia.container.flex",
            "props": {
              "direction": "column",
              "wrap": "nowrap",
              "style": {
                "marginBottom": "4px",
                "marginTop": "8px"
              }
            },
            "position": {
              "basis": "58px",
              "shrink": 0
            },
            "children": [
              {
                "meta": {
                  "name": "TrendIntroText",
                  "hasDelegate": true
                },
                "type": "ia.display.label",
                "props": {
                  "text": "Historical Trends",
                  "style": {
                    "color": "#102a43",
                    "fontSize": "20px",
                    "fontWeight": 700
                  }
                },
                "position": {
                  "basis": "28px",
                  "shrink": 0
                }
              },
              {
                "meta": {
                  "name": "TrendIntroSubtitle",
                  "hasDelegate": true
                },
                "type": "ia.display.label",
                "props": {
                  "text": "Use the date-range and pen controls in each Power Chart. The run-once setup enables history on the required tags.",
