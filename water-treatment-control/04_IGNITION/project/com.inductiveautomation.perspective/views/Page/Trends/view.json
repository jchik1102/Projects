                    "type": "line",
                    "interpolation": "curveLinear",
                    "breakLine": true,
                    "styles": {
                      "normal": {
                        "stroke": {
                          "color": "#006d75",
                          "opacity": 1,
                          "width": 2
                        }
                      }
                    }
                  },
                  "data": {
                    "source": "[default]WaterTreatment/Plant/T101/LIT101_PV",
