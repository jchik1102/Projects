              "config": {
                "mode": "realtime",
                "refreshRate": 1000,
                "pointCount": 1000,
                "unitOfTime": 15,
                "measureOfTime": "minutes",
                "visibility": {
                  "showTagBrowser": false,
                  "showDateRangeSelector": true,
                  "showPenControlDisplay": true
