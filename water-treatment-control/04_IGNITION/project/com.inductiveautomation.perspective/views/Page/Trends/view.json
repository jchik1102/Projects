          "direction": "column",
          "wrap": "nowrap",
          "style": {
            "paddingBottom": "12px",
            "paddingLeft": "16px",
            "paddingRight": "16px"
          }
        },
        "position": {
          "grow": 1,
          "shrink": 1
        },
        "children": [
          {
            "meta": {
              "name": "TrendIntro"
