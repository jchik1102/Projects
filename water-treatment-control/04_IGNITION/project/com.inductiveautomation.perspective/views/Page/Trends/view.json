{
  "custom": {},
  "params": {},
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "type": "ia.display.view",
        "props": {
          "params": {
            "icon": "show_chart",
            "text": "Historical Trends"
          },
          "path": "Page/Embedded/Title"
        },
        "position": {
          "basis": "56px",
          "shrink": 0
        }
      },
      {
        "meta": {
          "name": "TrendContent"
        },
        "type": "ia.container.flex",
